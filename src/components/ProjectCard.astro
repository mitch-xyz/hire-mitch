---
import type { Project } from '../data/projects';
import Media from './Media.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { slug, title, tagline, cover, cta } = project;

const link =
  cta === 'detail'
    ? { href: `/${slug}/`, label: 'See More', external: false }
    : cta
      ? { href: cta.href, label: 'See Website', external: true }
      : undefined;
---

<article class="flex flex-col gap-12 mb-20 max-lg:gap-8 max-lg:mb-10 max-md:gap-6">
  <Media media={cover} alt={`${title} design`} class="w-full object-cover aspect-video" eager={eager} />

  <div class="flex flex-row justify-between items-start gap-4 w-full max-md:flex-col">
    <div class="flex flex-col gap-4">
      <h2 class="font-bold tracking-[-0.02em] leading-[1.1] text-ink text-[3rem] max-lg:text-[2.25rem] max-md:text-[36px]">
        {title}
      </h2>
      <p class="text-ink/60 text-[24px] max-lg:text-[20px]">{tagline}</p>
    </div>

    {
      link && (
        <div class="flex flex-row gap-4 mt-2 max-lg:mt-0">
          <a
            class="flex flex-row items-center justify-center gap-2 py-2 text-ink text-[1.25rem] font-semibold text-left"
            href={link.href}
            {...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
          >
            {link.label}
            <ArrowIcon />
          </a>
        </div>
      )
    }
  </div>
</article>
