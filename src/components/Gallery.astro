---
import type { Media as MediaItem } from '../content.config';
import Media from './Media.astro';

interface Props {
  items: MediaItem[];
  title: string;
}

const { items, title } = Astro.props;
---

<div class="flex flex-col gap-20 w-full">
  {
    items.map((item, i) => (
      <Media
        media={item}
        alt={`${title} — image ${i + 1} of ${items.length}`}
        class:list={['w-full h-auto object-cover', item.type === 'video' && 'aspect-video']}
        eager={i === 0}
      />
    ))
  }
</div>
