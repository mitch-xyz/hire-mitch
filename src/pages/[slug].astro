---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';

// One page per project, at /<slug>/ — generated from src/content/projects.
export const getStaticPaths = (async () => {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { project: { slug: entry.id, ...entry.data } },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<Layout title={`${project.title} - Projects`}>
  <section class="flex flex-col items-center w-full bg-white py-[140px] max-lg:py-[100px] max-md:pb-[70px]">
    <div class="page-container">
      <div class="flex flex-col items-center w-full gap-[72px] max-md:gap-6">
        <div class="flex flex-col items-center gap-4 w-full max-w-[680px]">
          <h1 class="font-bold tracking-[-0.02em] text-display text-center max-lg:text-5xl max-md:text-[32px]">
            {project.title}
          </h1>
          <p class="text-lg text-ink/60 text-center">{project.tagline}</p>
        </div>
        <div class="flex flex-col w-full">
          <Gallery items={project.gallery} title={project.title} />
        </div>
      </div>
    </div>
  </section>
</Layout>
