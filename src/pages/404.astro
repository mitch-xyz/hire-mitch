---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Error 404 - Page not found" description="The page you are looking for could not be found." bare>
  <section class="flex flex-col gap-4 py-12 h-screen">
    <div class="max-w-7xl mx-auto px-4 h-screen">
      <div class="flex flex-col items-center justify-center gap-1.5 h-full text-center">
        <h1 class="font-bold text-ink text-3xl">404</h1>
        <p class="text-xs text-ink">Page not found</p>
        <p class="text-xs text-ink">The page you are looking for does not exist.</p>
        <a class="mt-4 text-xs text-ink underline" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
