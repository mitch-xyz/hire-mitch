---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Error 500 - Server error" description="An unexpected error occurred. Please try again later." bare>
  <section class="flex flex-col gap-4 py-12 h-screen">
    <div class="max-w-[80rem] mx-auto px-4 h-screen">
      <div class="flex flex-col items-center justify-center gap-1.5 h-full text-center">
        <h1 class="font-bold text-[#111827] text-[30px]">500</h1>
        <p class="text-[12px] text-[#111827]">Server error</p>
        <p class="text-[12px] text-[#111827]">An unexpected error occurred. Please try again later.</p>
        <a class="mt-4 text-[12px] text-[#111827] underline" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
